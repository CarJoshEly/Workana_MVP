generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(FREELANCER)
  bio       String?
  avatarUrl String?
  createdAt DateTime   @default(now())

  projects  Project[]
  proposals Proposal[]
}

enum Role {
  CLIENT
  FREELANCER
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  budget      Float
  category    String
  deadline    DateTime?
  status      ProjectStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  clientId  String
  client    User       @relation(fields: [clientId], references: [id])
  proposals Proposal[]
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model Proposal {
  id        String         @id @default(cuid())
  message   String
  price     Float
  status    ProposalStatus @default(PENDING)
  createdAt DateTime       @default(now())

  freelancerId String
  freelancer   User    @relation(fields: [freelancerId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}