generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(FREELANCER)
  bio       String?
  avatarUrl String?
  createdAt DateTime   @default(now())

  projects  Project[]
  proposals Proposal[]
  clientContracts     Contract[] @relation("ClientContracts")
  freelancerContracts Contract[] @relation("FreelancerContracts")
  clientConversations     Conversation[] @relation("ClientConversations")
  freelancerConversations Conversation[] @relation("FreelancerConversations")
  sentMessages            Message[]      @relation("SentMessages")
}

enum Role {
  CLIENT
  FREELANCER
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  budget      Float
  category    String
  deadline    DateTime?
  status      ProjectStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  clientId  String
  client    User       @relation(fields: [clientId], references: [id])
  proposals Proposal[]
  contract  Contract?
  conversations Conversation[]
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model Proposal {
  id        String         @id @default(cuid())
  message   String
  price     Float
  status    ProposalStatus @default(PENDING)
  createdAt DateTime       @default(now())

  freelancerId String
  freelancer   User    @relation(fields: [freelancerId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  contract Contract?
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Contract {
  id           String         @id @default(cuid())
  price        Float
  status       ContractStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id])

  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id])

  clientId String
  client   User   @relation("ClientContracts", fields: [clientId], references: [id])

  freelancerId String
  freelancer   User   @relation("FreelancerContracts", fields: [freelancerId], references: [id])
}

model Conversation {
  id           String   @id @default(cuid())
  projectId    String
  clientId     String
  freelancerId String
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id])
  client     User    @relation("ClientConversations", fields: [clientId], references: [id])
  freelancer User    @relation("FreelancerConversations", fields: [freelancerId], references: [id])
  messages   Message[]

  @@unique([projectId, clientId, freelancerId])
  @@index([clientId])
  @@index([freelancerId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}
